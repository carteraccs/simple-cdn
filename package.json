{
  "name": "simple-cdn",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight, self-hostable CDN with automatic routing, branded landing pages, and filesystem-based asset management.",
  "scripts": {
    "dev": "next dev",
    "sync": "bun scripts/sync-images.ts",
    "prebuild": "bun run sync",
    "build": "next build",
    "start": "bun run sync && next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.3",
  "overrides": {
    "postcss": "8.5.23",
    "postcss-selector-parser": "7.1.6"
  }
}
